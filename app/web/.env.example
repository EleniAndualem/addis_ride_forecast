# Environment variables for the web app. On Vercel: Project → Settings → Environment Variables.
# Locally (npm run dev / next start): copy to .env.local, which git ignores.

# Optional. CARTO key for the basemap tiles; read only on the server by /api/basemap, never sent to the browser.
# CARTO's public basemaps also load without a key.
CARTO_API_KEY=

# Optional. Leave empty on Vercel: the app then uses its own /api routes.
# Set it only to point the front end at a separately hosted FastAPI server (python app/app.py), e.g.
# NEXT_PUBLIC_API_BASE=https://your-api.example.com
NEXT_PUBLIC_API_BASE=
